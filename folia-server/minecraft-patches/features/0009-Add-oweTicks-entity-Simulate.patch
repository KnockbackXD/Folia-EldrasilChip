@@ -0,0 +1,139 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.concurrentutil.scheduler.SchedulableTick;
+import ca.spottedleaf.moonrise.common.time.TickData;
+import io.papermc.paper.configuration.WorldConfiguration;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.npc.villager.Villager;
+
+public final class OweTicks {
+
+    private static final ThreadLocal<PressureCache> PRESSURE_CACHE = ThreadLocal.withInitial(PressureCache::new);
+
+    private OweTicks() {
+    }
+
+    public static boolean shouldSkipInactiveTick(final Entity entity) {
+        final WorldConfiguration.Entities.OweTicks config = entity.level().paperConfig().entities.oweTicks;
+        if (!config.enabled) {
+            entity.oweTicks = 0;
+            return false;
+        }
+
+        if (!isEligible(entity, config)) {
+            entity.oweTicks = 0;
+            return false;
+        }
+
+        final long currentTick = RegionizedServer.getCurrentTick();
+        if ((currentTick - entity.activatedTick) < Math.max(0, config.minimumInactiveTicks)) {
+            forgiveOne(entity);
+            return false;
+        }
+
+        if (!isRegionPressured(config)) {
+            forgiveOne(entity);
+            return false;
+        }
+
+        final int skipRate = Math.max(1, config.skipRate);
+        if (skipRate <= 1) {
+            forgiveOne(entity);
+            return false;
+        }
+
+        final int maxOweTicks = Math.max(1, config.maxOweTicks);
+        if (entity.oweTicks >= maxOweTicks) {
+            forgiveOne(entity);
+            return false;
+        }
+
+        if (Math.floorMod(currentTick + entity.getId(), (long)skipRate) == 0L) {
+            forgiveOne(entity);
+            return false;
+        }
+
+        entity.oweTicks = Math.min(maxOweTicks, entity.oweTicks + 1);
+        return true;
+    }
+
+    private static boolean isEligible(final Entity entity, final WorldConfiguration.Entities.OweTicks config) {
+        if (!(entity instanceof Mob)) {
+            return false;
+        }
+        if (!config.includeVillagers && entity instanceof Villager) {
+            return false;
+        }
+        return !entity.moonrise$hasAnyPlayerPassengers();
+    }
+
+    private static boolean isRegionPressured(final WorldConfiguration.Entities.OweTicks config) {
+        final SchedulableTick task = TickRegionScheduler.getCurrentTickingTask();
+        if (!(task instanceof final TickRegionScheduler.RegionScheduleHandle handle) || handle.region == null) {
+            return false;
+        }
+
+        final long currentTick = handle.getCurrentTick();
+        final double triggerMspt = Math.max(0.0D, config.triggerMspt);
+        final double triggerTps = Math.max(0.0D, config.triggerTps);
+        final PressureCache cache = PRESSURE_CACHE.get();
+        if (cache.matches(handle, currentTick, triggerMspt, triggerTps)) {
+            return cache.pressured;
+        }
+
+        boolean pressured = false;
+        final TickData.TickReportData report = handle.getTickReport5s(System.nanoTime());
+        if (report != null) {
+            final double mspt = report.timePerTickData().segmentAll().average() / 1.0E6D;
+            final double tps = report.tpsData().segmentAll().average();
+            pressured = (triggerMspt > 0.0D && mspt >= triggerMspt) || (triggerTps > 0.0D && tps <= triggerTps);
+        }
+
+        cache.update(handle, currentTick, triggerMspt, triggerTps, pressured);
+        return pressured;
+    }
+
+    private static void forgiveOne(final Entity entity) {
+        if (entity.oweTicks > 0) {
+            --entity.oweTicks;
+        } else if (entity.oweTicks < 0) {
+            entity.oweTicks = 0;
+        }
+    }
+
+    private static final class PressureCache {
+
+        private TickRegionScheduler.RegionScheduleHandle handle;
+        private long currentTick = Long.MIN_VALUE;
+        private double triggerMspt;
+        private double triggerTps;
+        private boolean pressured;
+
+        private boolean matches(
+            final TickRegionScheduler.RegionScheduleHandle handle,
+            final long currentTick,
+            final double triggerMspt,
+            final double triggerTps
+        ) {
+            return this.handle == handle
+                && this.currentTick == currentTick
+                && Double.compare(this.triggerMspt, triggerMspt) == 0
+                && Double.compare(this.triggerTps, triggerTps) == 0;
+        }
+
+        private void update(
+            final TickRegionScheduler.RegionScheduleHandle handle,
+            final long currentTick,
+            final double triggerMspt,
+            final double triggerTps,
+            final boolean pressured
+        ) {
+            this.handle = handle;
+            this.currentTick = currentTick;
+            this.triggerMspt = triggerMspt;
+            this.triggerTps = triggerTps;
+            this.pressured = pressured;
+        }
+    }
+}
